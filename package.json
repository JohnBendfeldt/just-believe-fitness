  "version": "0.0.0",
  "license": "MIT",
  "author": {
    "name": "John Bendfeldt",
    "url": "https://johnbendfeldt.com/"
  },
  "homepage": "https://jbfit.studio/",
  "repository": {
    "type": "git",
    "url": "https://github.com/JohnBendfeldt/just-believe-fitness.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "test:visual": "node scripts/visual-layout-test.mjs",
    "verify": "npm test && npm run lint && npm run build && npm run test:visual",
    "verify:deploy": "npm test && npm run lint && npm run build",
    "preview": "vite preview",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "garmin:token": "node scripts/garmin-token.mjs",
    "audio:coach": "python3 scripts/generate-coach-audio.py"
  },
  "dependencies": {
    "@capacitor-community/bluetooth-le": "^8.4.0",
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/core": "^8.6.2",
    "garminconnect-js": "^0.11.1",
    "lucide-react": "^1.73.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@capacitor/ios": "^8.6.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-bluetooth": "^0.0.22",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.8",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "playwright-core": "^1.65.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
