# Optional Netlify / Vite Environment Variables (from https://www.strava.com/settings/api)
# On Netlify, setting STRAVA_CLIENT_ID and STRAVA_CLIENT_SECRET in Site Configuration -> Environment Variables
# keeps your Strava secret server-side via netlify/functions/strava-token.mjs (or you can enter them in-app).
VITE_STRAVA_CLIENT_ID=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Optional Garmin Connect Personal API Key (GCDC_... from Garmin Connect -> Settings -> Personal API Key)
# Enables read-only Athlete Profile (weight, height, max/resting HR, FTP) & Recent Activities sync via personal.connectapi.garmin.com.
GARMIN_PERSONAL_API_KEY=
